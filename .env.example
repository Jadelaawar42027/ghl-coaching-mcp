# --- GHL (GoHighLevel) API ---
GHL_API_TOKEN=your_ghl_private_integration_or_agency_token
GHL_LOCATION_ID=your_ghl_location_id
GHL_COMPANY_ID=your_ghl_company_id

# --- HTTP server (server-http.js only) ---
# Any long random string - this is the shared secret the WhatsApp bot must
# present to call this server. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=generate_a_long_random_string_here
MCP_PORT=4000
