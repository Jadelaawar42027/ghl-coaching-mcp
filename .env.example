# --- GHL (GoHighLevel) API ---
GHL_API_TOKEN=your_ghl_private_integration_or_agency_token
GHL_LOCATION_ID=your_ghl_location_id
GHL_COMPANY_ID=your_ghl_company_id

# --- HTTP server (server-http.js only) ---
# Shared secret used to verify signed identity tokens from the WhatsApp bot
# (who's calling: name, role, ghlUserId). Must match the WhatsApp bot's
# JWT_SECRET exactly. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_long_random_string_here
MCP_PORT=4000
